    RABBITMQ_API_PASSWORD="" \
    RABBITMQ_VHOST="" \
    RABBITMQ_CLOUD_URL="" \
    SWAGGER_USER="" \
    SWAGGER_PASSWORD="" \
    AUTH_TOKEN_ENDPOINT="" \
